# Copy to .env.local (never commit it). Both are optional; without them the Inspector
# still works using the built-in offline answers and the browser's voice.

# Live voice conversation with Inspector Byte (Gemini Live). Key from aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Charon

# Typed answers from Claude (text chat)
ANTHROPIC_API_KEY=
